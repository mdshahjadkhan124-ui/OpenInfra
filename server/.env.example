# ===============================================================
# SERVER ENVIRONMENT
# Copy this file to `server/.env` and fill in every value.
# ===============================================================

# --- Core ------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database --------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/openinfra
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/openinfra
MONGO_URI=

# --- Auth ------------------------------------------------------
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Google Gemini (AI vision) ---------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Cloudinary (image storage) --------------------------------
# https://console.cloudinary.com/  -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google OAuth 2.0 ------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Email (Nodemailer + Gmail) --------------------------------
# EMAIL_PASS must be a Gmail *App Password*, not your account password.
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=OpenInfra

# --- Blockchain ------------------------------------------------
# Address of the deployed InfraEscrow contract (set after Phase 6).
CONTRACT_ADDRESS=
# Sepolia JSON-RPC endpoint (Alchemy / Infura / public node).
SEPOLIA_RPC_URL=
# Base URL used when building Etherscan links in emails.
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io

# --- Frontend --------------------------------------------------
CLIENT_URL=http://localhost:5173
