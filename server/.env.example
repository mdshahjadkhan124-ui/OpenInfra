# ===============================================================
# SERVER ENVIRONMENT
# Copy this file to `server/.env` and fill in every value.
# ===============================================================

# --- Core ------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database --------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/openinfra
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/openinfra
MONGO_URI=
# Database name. Set explicitly because Atlas SRV strings usually omit it
# (mongoose would otherwise silently use `test`).
MONGO_DB_NAME=openinfra

# --- Auth ------------------------------------------------------
# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Google Gemini (AI vision) ---------------------------------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Vision-capable model used for relevance, costing and milestone verification.
GEMINI_MODEL=gemini-2.5-flash
# Market context for the AI cost estimate. The estimate is meaningless without
# a currency and a region to price against.
REPORT_CURRENCY=INR
REPORT_REGION=India
# Largest report/progress photo accepted, in megabytes.
MAX_UPLOAD_MB=10

# --- Fixture mode ----------------------------------------------------
# Replace Gemini and Cloudinary with deterministic canned responses so
# routine development and tests do not spend API quota. Always on when
# NODE_ENV=test. Set MOCK_EXTERNAL=true to mock both, or either flag alone.
MOCK_EXTERNAL=false
MOCK_AI=false
MOCK_UPLOADS=false
MOCK_CHAIN=false
MOCK_EMAIL=false

# --- Bid anomaly detection (Phase 5) ---------------------------------
# A bid is flagged when it exceeds the AI estimate's UPPER bound by more
# than this percentage.
ANOMALY_MARGIN_PERCENT=20

# --- Cloudinary (image storage) --------------------------------
# https://console.cloudinary.com/  -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google OAuth 2.0 ------------------------------------------
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- Email (Nodemailer + Gmail) --------------------------------
# EMAIL_PASS must be a Gmail *App Password*, not your account password.
# https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=OpenInfra
# Where preview-mode emails are written instead of being sent.
EMAIL_PREVIEW_DIR=.email-preview

# --- Blockchain ------------------------------------------------
# Address of the deployed InfraEscrow contract (set after Phase 6).
CONTRACT_ADDRESS=
# Sepolia JSON-RPC endpoint (Alchemy / Infura / public node).
SEPOLIA_RPC_URL=
# Admin wallet that signs lockFunds / releaseMilestone, WITHOUT the 0x prefix
# or with it — both work. Use a THROWAWAY testnet key only.
#
# SECURITY: a server holding this key can move every escrowed rupee with no
# human present. Phase 9 moves signing to the admin's MetaMask, after which
# this should be removed. See server/src/services/chain.service.js.
CHAIN_ADMIN_PRIVATE_KEY=
CHAIN_ID=11155111
CHAIN_CONFIRMATIONS=1
# Test ETH escrowed per project when the admin does not specify an amount.
DEFAULT_ESCROW_ETH=0.004
# Base URL used when building Etherscan links in emails.
ETHERSCAN_BASE_URL=https://sepolia.etherscan.io

# --- Frontend --------------------------------------------------
CLIENT_URL=http://localhost:5173
