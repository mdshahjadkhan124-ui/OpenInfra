# ===============================================================
# CLIENT ENVIRONMENT
# Copy this file to `client/.env` and fill in every value.
# Only VITE_* prefixed vars are exposed to the browser.
# ===============================================================

VITE_API_URL=http://localhost:5000/api

# Same Client ID as the server's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Deployed InfraEscrow contract address (set after Phase 6).
VITE_CONTRACT_ADDRESS=

# Sepolia chain id in hex, used to prompt MetaMask network switches.
VITE_CHAIN_ID=0xaa36a7
VITE_ETHERSCAN_BASE_URL=https://sepolia.etherscan.io
