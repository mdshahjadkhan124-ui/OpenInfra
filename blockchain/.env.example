# ===============================================================
# BLOCKCHAIN ENVIRONMENT
# Copy this file to `blockchain/.env` and fill in every value.
# ===============================================================

# Sepolia JSON-RPC endpoint (Alchemy / Infura / public node).
SEPOLIA_RPC_URL=

# Deployer wallet private key (NO 0x prefix needed, both work).
# Use a THROWAWAY testnet wallet only. Never a real-funds key.
PRIVATE_KEY=

# https://etherscan.io/myapikey  -- used for contract verification.
ETHERSCAN_API_KEY=
